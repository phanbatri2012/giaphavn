# Routing
ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_ROOT_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
PUBLIC_REGISTRATION_ENABLED=false
PAYMENTS_ENABLED=false

# Supabase (leave blank to use the seeded local demo repository)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authentication providers are configured in Supabase Dashboard
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# payOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Email / anti-abuse / observability
RESEND_API_KEY=
RESEND_FROM_EMAIL=GiaPhaVN <no-reply@example.vn>
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-at-least-32-random-characters
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Demo-only protected tree value. Production stores only an Argon2id hash.
DEMO_TREE_ACCESS_CODE=
TREE_ACCESS_COOKIE_SECRET=replace-with-at-least-32-random-characters
