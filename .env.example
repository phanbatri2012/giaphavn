# Routing
ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_ROOT_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
APP_MODE=personal
PERSONAL_FAMILY_SLUG=demo-hong-viet
# Chỉ bật trên máy phát triển. Dữ liệu chỉnh sửa được lưu trong .data/ (Git bỏ qua).
LOCAL_DEMO_PERSISTENCE=true
# SQLite là kho dữ liệu chính của Personal Edition.
PERSONAL_DATABASE_FILE=giaphavn.sqlite
# File JSON cũ chỉ được đọc một lần để tự động chuyển dữ liệu sang SQLite.
LOCAL_DEMO_DATA_FILE=demo-state.json
PUBLIC_REGISTRATION_ENABLED=false
PAYMENTS_ENABLED=false

# Supabase (leave blank to use the seeded local demo repository)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Các tích hợp email, OAuth và thanh toán không được dùng trong Personal Edition.
# Anti-abuse / observability chỉ cần khi website được đưa lên Internet.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-at-least-32-random-characters
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Mã phả đồ được hash Argon2id và lưu trong SQLite; chỉ khóa ký cookie nằm trong env.
TREE_ACCESS_COOKIE_SECRET=replace-with-at-least-32-random-characters
